{
  "name": "search",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "next:dev": "next dev",
    "worker:dev": "set -a && . ./.env && set +a && NODE_OPTIONS=\"--import tsx\" npx graphile-worker -c \"$DATABASE_URL\"",
    "dev": "concurrently -n \"Next,Worker\" -c \"cyan,magenta\" \"npm run next:dev\" \"npm run worker:dev\"",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "ai": "tsx main.ts",
    "prepare": "husky install",
    "format": "prettier --write .",
    "test": "echo \"No tests specified yet\" && exit 0",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:server": "set -a && . ./.server.env && set +a && npx prisma db push",
    "worker": "graphile-worker",
    "worker:prod": "set -a && . ./.server.env && set +a && NODE_OPTIONS=\"--import tsx\" npx graphile-worker -c \"$DATABASE_URL\""
  },
  "dependencies": {
    "@langchain/community": "^1.1.28",
    "@langchain/core": "^1.2.1",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.3.6",
    "@langchain/ollama": "^1.2.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@tavily/core": "^0.7.3",
    "fs": "^0.0.1-security",
    "husky": "^9.1.7",
    "langchain": "^1.4.4",
    "next": "^16.2.9",
    "pg": "^8.21.0",
    "postgraphile": "^4.14.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "tsx": "^4.22.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "lint-staged": "^13.2.0",
    "prettier": "^2.8.8",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md,mdx,html,scss}": [
      "prettier --write",
      "git add"
    ]
  }
}
